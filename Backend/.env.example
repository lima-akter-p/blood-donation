MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
IMGBB_API_KEY=configure-your-imgbb-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
API_PUBLIC_URL=https://your-public-api.example.com
SSLCOMMERZ_STORE_ID=configure-your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=configure-your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false
SMTP_HOST=configure-your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=configure-your-smtp-username
SMTP_PASSWORD=configure-your-smtp-password
MAIL_FROM=LifeDrop <no-reply@example.com>
